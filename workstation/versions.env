# Versoes fixadas da workstation AI-DLC (NFR2). Formato CHAVE=valor, sem aspas.
# "confirmar" = valor que ainda nao foi verificado no ambiente; nao e uma versao real.

# Imagem base UBI 9 com Node.js 22 (Node 22 e a escolha do projeto: o requisito
# de Node do Copilot CLI nao esta documentado). Tag e digest: confirmar.
BASE_IMAGE=registry.access.redhat.com/ubi9/nodejs-22
BASE_IMAGE_TAG=latest
# Digest observado em 2026-10-01 (referencia; o build usa a tag acima).
BASE_IMAGE_DIGEST=sha256:99cef5d0a64011463c411db508b1570f9edc37219dd38eabbf90bb8c0e45ccc3

# GitHub Copilot CLI (pacote npm @github/copilot). O AI-DLC exige >= 1.0.74.
COPILOT_CLI_VERSION=1.0.91

# AI-DLC da AWS (awslabs/aidlc-workflows), release publicada.
AIDLC_VERSION=v2.10.0

# OpenShift Local (CRC) e operador Red Hat OpenShift Dev Spaces: confirmar.
CRC_VERSION=2.42.0
DEVSPACES_OPERATOR_VERSION=confirmar
